{
  // ==========================================================================
  // CodeBuddy Agent 命令执行权限（**运行期偏好**）
  //
  // 【为什么单独一个文件，而不是写在 .ide/settings.json 里】（2026-09-25 拆分）
  //   1. 本段各键的 `scope = application` ⇒ **只能写在 User 级**（仓库级 `.vscode/settings.json`
  //      与镜像里 Machine 级的那份**都不生效**），且平台会在环境启动时覆盖 `User/settings.json`
  //      ⇒ 它们**只能**由环境启动后的 stage `agent-permissions`（= `make apply-ide-settings`）合并进去。
  //   2. `.ide/settings.json` 是**镜像构建输入**（`.ide/Dockerfile` 的 COPY + `.cnb.yml` 的 `build.by`）
  //      ⇒ 改它一次就换掉镜像输入哈希、触发**整机重建**（约 20 min；平台下发 `--no-cache`）。
  //      而本段（尤其黑名单）恰恰是要**经常调**的 ⇒ 把它移出构建输入。
  //      ⚠️ 因此**本文件不得**被 Dockerfile COPY，也**不得**出现在 `.cnb.yml` 的 `build.by` 里
  //      （判据由 `tests/unit/test_apply_ide_settings.py` 的
  //       `test_runtime_preferences_file_is_not_a_build_input` 钉住；相关事实见
  //       `docs/research/2026-09-25-cnb-platform-behavior-facts.md` 的"镜像缓存看日志才知"一条）。
  //   3. 两个源由**同一个脚本**按序合并（后者覆盖前者）：
  //      `.ide/settings.json`（镜像级预设，慢变）+ 本文件（运行期偏好，常变）。
  //
  // 【行为口径：指针，不复述】
  //   · 生效路径 / 复跑命令 / 故障判据 → docs/engineering/agent-command-gate.md
  //     （尤其 §5 的 `D7`：切分与大小写，以及 §6「已知边界」）
  //   · 决策与论证 → docs/adr/0032-agent-command-gate-and-ide-settings.md
  //   · 威胁与残余风险 → docs/design/threat-model/untrusted-input-and-agentic.md 的 `T-15`
  //   · 红线判据（哪些操作不可回退）→ docs/engineering/git-workflow.md §4 的 A~F 分级
  //   ⚠️ 本文件**只列条目，不定义红线**：黑名单是既有红线的**投影**，不是第二个真源。
  // ==========================================================================

  // 1) 默认全自动：命令 / MCP / 文件写入一律不再弹确认
  "codingcopilot.autoRun": true,
  // `autoRunMode` 在 4.12.38765564 的 package.json 里**未声明**（扩展内部读的是 `chat.autoRunMode`）；
  // 写上无害且与参考实现一致，断言它以防将来版本改变语义。
  "codingcopilot.autoRunMode": "runEverything",
  "codingcopilot.autoAcceptWebSearch": true,

  // 2) 唯一保留的自动化硬红线：**删库**（阈值默认 500 → 收紧到 200）
  //    删除先入回收站，批量删除达阈值仍需确认；它与下面「禁用的类别」是两件事，
  //    关掉 `fileDelete` **不影响**本条（回收站是独立机制）。
  "codingcopilot.safeDeleteEnabled": true,
  "codingcopilot.safeDeleteBulkThreshold": 200,

  // 3) 关闭的内置安全类别：**全关，只留 custom**
  //    理由：内置类别是**文本启发式**，误报来源多（典型：`(curl|wget).*\|(sh|bash|python)`
  //    命中即判 injection 高危），而它们**不是**安全边界、只是提示。全关之后
  //    「**拦截范围 = 下面明确列出的内容**」，行为可预测、可评审。
  //    ⇒ 代价如实登记：关掉 `injection` 后，下载即执行的命令不再被拦（已知风险）；
  //      要恢复防注入，把 `"injection"` 从本数组删掉即可（一行改动）。
  //    ⇒ 本数组**不得**加回 `"custom"`：那会让第 4 项黑名单**静默失效**
  //      （`scripts/apply_ide_settings.py` 对此有断言，改了会红）。
  "codingcopilot.disabledSecurityCategories": [
    "diskOps",
    "windowsSystem",
    "network",
    "systemServices",
    "userManagement",
    "fileDelete",
    "permissions",
    "processControl",
    "gitOps",
    "injection",
    "scriptExec",
    "powershell"
  ],

  // 4) 需要人工确认的命令（自定义黑名单：元素为正则，命中即弹确认，**不是**直接拒绝）
  //    关掉上述 12 类之后，这里是**唯一**还会拦命令的闸门 ⇒ 每条都要能说清"为什么它不可逆"。
  //    ⚠️ 这是**提醒层**而非安全边界：改写形式（`r''m`、变量展开、`git -c … push --force`、
  //       `python -c "shutil.rmtree('/')"`）可以绕过；真正的红线判据见上方指针。
  //    ⚠️ 它按**文本**匹配 ⇒ 把红线文本**当数据**传递（提交信息、`grep "git push --force" docs/`）
  //       同样会触发确认。这是刻意的取舍（可评审 > 语义解析），已登记在
  //       `agent-command-gate.md` 的 §5 `D9`；写这类文本时用 `git commit -F <文件>` 规避。
  //    ⚠️ 条目**只增不减**是真实风险 ⇒ 删除条件与复核点见 ADR-0032 §7 末段。
  "codingcopilot.customBlacklistCommands": [
    // —— A. 文件系统 / 磁盘（不可逆）——
    // 删除根目录、家目录、当前目录、通配符或仓库本体
    "\\brm\\s+(?:-[a-zA-Z]+\\s+)*-(?:[rR]f?|f?[rR])\\s+(?:/|/\\*|~|\\$HOME|\\.\\.?/?|\\*|/workspace/?(?:\\*)?)(?:\\s|$)",
    "\\brm\\b[^\\n]*--no-preserve-root",
    "\\brm\\b[^\\n]*\\.git\\b",
    // 在根 / 家目录上做破坏性 find（`find … -exec rm` / `-delete`）
    "\\bfind\\s+(?:/|~|\\$HOME)[^\\n]*-(?:delete|exec|execdir)\\b",
    "\\bdd\\b[^\\n]*\\bof=/dev/",
    "\\bmkfs(?:\\.[a-z0-9]+)?\\b",
    "\\b(?:fdisk|parted|cfdisk|sfdisk|wipefs)\\b",
    ">\\s*/dev/(?:sd|hd|nvme|vd|mmcblk)",
    // 2026-09-25 补：另外两条"把块设备清零"的写法（`dd` 之外的常用工具），只匹配 `/dev/<块设备>`
    "\\b(?:truncate|shred)\\b[^\\n]*\\s/dev/(?:sd|hd|nvme|vd|mmcblk)",
    "\\bchmod\\s+(?:-R\\s+)?777\\s+/",
    "\\b(?:kill|killall|pkill|taskkill)\\b[^\\n]*\\b(?:1|init|systemd|kernel)\\b",

    // —— B. 数据库（「删库」）——
    "\\b(?:DROP|drop)\\s+(?:DATABASE|database|SCHEMA|schema|TABLE|table)\\b",
    "\\bdropdb\\b",
    "\\bmysqladmin\\b[^\\n]*\\bdrop\\b",
    "\\b(?:FLUSHALL|flushall|FLUSHDB|flushdb)\\b",
    // 2026-09-25 补：把数据库**数据目录**整目录删掉（`dropdb` 之外的第二条"删库"路径；路径精确 ⇒ 几乎无误报）
    "\\brm\\b[^\\n]*/var/lib/(?:mysql|mariadb|postgresql|mongodb)\\b",

    // —— C. 宿主（会把环境本身弄没）——
    "\\b(?:shutdown|reboot|poweroff|halt)\\b",
    ":\\(\\)\\s*\\{",

    // —— D. Git / 仓库：项目 D 类红线（改写已推送历史 / 强推 / 删远端分支）——
    //    原本由内置 `gitOps` 类别承担，该类别已关闭 ⇒ 在此逐条补回（日常 git 操作零摩擦）。
    "\\bgit\\s+push\\b[^\\n]*--force",
    "\\bgit\\s+push\\b[^\\n]*\\s-f(?:\\s|$)",
    "\\bgit\\s+push\\b[^\\n]*--delete\\b",
    // 2026-09-25 补：`--mirror` 会**删除远端存在而本地没有**的引用（等同批量删远端分支）
    "\\bgit\\s+push\\b[^\\n]*--mirror\\b",
    "\\bgit\\s+push\\b[^\\n]*\\s:\\S+",
    // `rebase` 用负向先行断言排掉 `--abort/--continue/--skip/--quit`：这些是**中止/收尾**，不改写历史
    "\\bgit\\s+reset\\s+--hard\\b",
    "\\bgit\\s+rebase\\b(?![^\\n]*--(?:abort|continue|skip|quit)\\b)",
    "\\bgit\\s+reflog\\s+expire\\b",
    "\\bgit\\s+filter-(?:branch|repo)\\b",
    // 清空工作树的三种写法（含多会话纪律里"不带路径的 stash 会收走他人改动"）
    "\\bgit\\s+clean\\b[^\\n]*-[a-zA-Z]*[fFdDxX]",
    "\\bgit\\s+restore\\b[^\\n]*\\s\\.\\s*$",
    "\\bgit\\s+checkout\\b[^\\n]*(?:-f\\b|--force\\b|--\\s+\\.\\s*$)",
    // 2026-09-25 补：`git checkout .` 与 `git checkout -- .` 同义（丢弃工作树改动），此前只拦了后者
    "\\bgit\\s+checkout\\s+\\.\\s*$",
    "\\bgit\\s+stash\\s*$",
    // 2026-09-25 补：`git stash -u/-a` 等"带旗标但不带路径"的写法同样会收走全工作树；
    // 带 `--` 路径的写法（多会话纪律允许的那种）**不**在此列
    "\\bgit\\s+stash\\s+(?:-\\S+\\s*)+$",
    "\\bgit\\s+stash\\s+(?:drop|clear)\\b",
    // B 类：写 main 需事先批准
    "\\bgit\\s+push\\b[^\\n]*\\b(?:main|master)\\b",
    // E 类：bench/data 只由跑测脚本写，人手不得直接提交
    "\\bgit\\s+push\\b[^\\n]*\\bbench/data\\b",
    // 禁止用 --no-verify 跳过 pre-commit / commit-msg 门禁
    "\\bgit\\s+commit\\b[^\\n]*--no-verify",

    // —— E. 混淆执行（injection 类别已关，只补最没有正当用途的一种）——
    //    注：**故意不拦** `curl … | sh` 这类安装惯用法 —— 它是参考实现实测到的最大误报源。
    "\\bbase64\\b[^\\n]*(?:-d|--decode)[^\\n]*\\|"
  ]
}
